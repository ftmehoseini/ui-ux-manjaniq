# Data source: "http" (default) or "sample".
# Sample data is also the automatic fallback in development when no backend is
# configured. It is never used by a production build unless set explicitly, and
# the stage shows a visible marker whenever it is active.
NEXT_PUBLIC_DATA_SOURCE=http

# Base URL of the registration API. With this unset, the HTTP adapter fails and
# the UI renders an honest "not connected" state rather than inventing content.
NEXT_PUBLIC_API_BASE_URL=

# Which event the root route ("/") registers people for. Any other event is
# reachable at /events/<slug>/register.
NEXT_PUBLIC_EVENT_SLUG=telsi-talk
