# Data source: "http" (default) or "sample".
# Sample data is also the automatic fallback in development when no backend is
# configured. It is never used by a production build unless set explicitly, and
# the app shows a persistent banner whenever it is active.
NEXT_PUBLIC_DATA_SOURCE=http

# Base URL of the Manjaniq API. With this unset, the HTTP adapter fails and the
# UI renders honest "not connected" states rather than inventing content.
NEXT_PUBLIC_API_BASE_URL=
